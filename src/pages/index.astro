---
import Main from "../layouts/main.astro";

const paths = [
    {
        href: "/learn/",
        title: "Learn",
        description:
            "Step-by-step tutorials for players and DMs. Start here if you're new.",
    },
    {
        href: "/docs/",
        title: "Docs",
        description: "Reference documentation for features, tools, and more.",
    },
    {
        href: "/server/setup/",
        title: "Server",
        description:
            "Self-host PlanarAlly, configure your instance, and manage users.",
    },
    {
        href: "/blog/",
        title: "Blog",
        description: "Release notes and development updates.",
    },
];

const features = [
    {
        title: "Lighting & vision",
        description: "Dynamic lights and line-of-sight.",
        href: "/docs/dm/lighting-vision/",
    },
    {
        title: "Layers, floors & locations",
        description: "Organise maps across layers, floors, and scenes.",
        href: "/docs/game/gameboard/",
    },
    {
        title: "Assets & templates",
        description: "Upload maps and tokens, save reusable presets.",
        href: "/docs/dm/assets/",
    },
    {
        title: "Build & Play tools",
        description: "Prep in Build mode, run sessions in Play mode.",
        href: "/docs/tools-overview/",
    },
    {
        title: "Self-hosting",
        description: "Run offline with full ownership of your data.",
        href: "/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="PlanarAlly logo"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                An open-source virtual tabletop for tabletop RPGs. Self-host it,
                play offline, and run immersive games with lighting, vision, and
                a flexible map system.
            </p>
        </section>

        <section class="paths">
            <h2>Get started</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>Core features</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>
