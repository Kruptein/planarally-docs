---
import Main from "../../layouts/main.astro";

const paths = [
    {
        href: "/es/learn/",
        title: "Aprende",
        description: "Tutoriales paso a paso para jugadores y DMs. Empieza aquí si eres nuevo.",
    },
    {
        href: "/es/docs/",
        title: "Documentación",
        description: "Documentación de referencia sobre funciones, herramientas y más.",
    },
    {
        href: "/es/server/setup/",
        title: "Servidor",
        description: "Aloja PlanarAlly por tu cuenta, configura tu instancia y gestiona usuarios.",
    },
    {
        href: "/es/blog/",
        title: "Blog",
        description: "Notas de versión y novedades del desarrollo.",
    },
];

const features = [
    {
        title: "Iluminación y visión",
        description: "Luces dinámicas y línea de visión.",
        href: "/es/docs/dm/lighting-vision/",
    },
    {
        title: "Capas, plantas y ubicaciones",
        description: "Organiza los mapas entre capas, plantas y escenas.",
        href: "/es/docs/game/gameboard/",
    },
    {
        title: "Recursos y plantillas",
        description: "Sube mapas y fichas, guarda ajustes predefinidos reutilizables.",
        href: "/es/docs/dm/assets/",
    },
    {
        title: "Herramientas de Build y Play",
        description: "Prepara en modo Build, dirige sesiones en modo Play.",
        href: "/es/docs/tools-overview/",
    },
    {
        title: "Autoalojamiento",
        description: "Juega sin conexión con pleno control de tus datos.",
        href: "/es/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="Logo de PlanarAlly"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                Un tablero virtual de código abierto para juegos de rol de mesa.
                Alójalo por tu cuenta, juega sin conexión y dirige partidas
                inmersivas con iluminación, visión y un sistema de mapas
                flexible.
            </p>
        </section>

        <section class="paths">
            <h2>Empieza aquí</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>Funciones principales</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>