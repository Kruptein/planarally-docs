---
import Main from "../../layouts/main.astro";

const paths = [
    {
        href: "/fr/learn/",
        title: "Apprendre",
        description: "Tutoriels pas à pas pour les joueurs et les DM. Commencez ici si vous êtes nouveau.",
    },
    {
        href: "/fr/docs/",
        title: "Documentation",
        description: "Documentation de référence sur les fonctionnalités, les outils et plus encore.",
    },
    {
        href: "/fr/server/setup/",
        title: "Serveur",
        description: "Auto-hébergez PlanarAlly, configurez votre instance et gérez vos utilisateurs.",
    },
    {
        href: "/fr/blog/",
        title: "Blog",
        description: "Notes de version et actualités du développement.",
    },
];

const features = [
    {
        title: "Éclairage et vision",
        description: "Lumières dynamiques et ligne de vue.",
        href: "/fr/docs/dm/lighting-vision/",
    },
    {
        title: "Calques, étages et emplacements",
        description: "Organisez les cartes entre calques, étages et scènes.",
        href: "/fr/docs/game/gameboard/",
    },
    {
        title: "Ressources et modèles",
        description: "Importez des cartes et des pions, enregistrez des préréglages réutilisables.",
        href: "/fr/docs/dm/assets/",
    },
    {
        title: "Outils Build et Play",
        description: "Préparez en mode Build, animez les sessions en mode Play.",
        href: "/fr/docs/tools-overview/",
    },
    {
        title: "Auto-hébergement",
        description: "Jouez hors ligne avec un contrôle total de vos données.",
        href: "/fr/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="Logo de PlanarAlly"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                Un tabletop virtuel open source pour les jeux de rôle. Auto-hébergez-le, jouez hors ligne et animez
                des parties immersives grâce à l'éclairage, à la vision et à un système de cartes flexible.
            </p>
        </section>

        <section class="paths">
            <h2>Commencez ici</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>Fonctionnalités principales</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>