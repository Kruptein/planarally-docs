---
import dayjs from "dayjs";
import Main from "../../../layouts/main.astro";
const posts = Object.values(import.meta.glob("./*.mdx", { eager: true }))
    .map(({ frontmatter, url }) => ({
        title: frontmatter.title,
        excerpt: frontmatter.excerpt,
        author: frontmatter.author,
        date: dayjs(frontmatter.date, "YYYY-MM-DD HH:MM:SS"),
        href: url,
    }))
    .sort((a, b) => {
        if (a.date.isBefore(b.date)) return 1;
        if (b.date.isBefore(a.date)) return -1;
        return 0;
    });
---

<Main>
    <main>
        <section>
            <h1 class="title text-gradient">PlanarAlly 博客</h1>
            <p>
                关注 PlanarAlly 的最新动态，见证它成为多元宇宙最佳 VTT 的旅程。
            </p>
        </section>

        {
            posts.map((post) => {
                return (
                    <a class="post" href={post.href}>
                        <div class="title">{post.title}</div>
                        <div class="excerpt">{post.excerpt}</div>
                        <div class="date">
                            发布于 {post.date.format("YYYY 年 M 月 D 日")}，作者 {post.author}
                        </div>
                    </a>
                );
            })
        }
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    section {
        text-align: center;
        margin: 50px 25px;
        max-width: 650px;
    }

    .post {
        display: block;
        border: solid 1px rgb(226, 236, 236);

        width: max(25vw, 300px);
        padding: 50px;
        margin-bottom: 50px;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .excerpt {
            margin-bottom: 25px;
        }

        .date {
            font-size: small;
        }
    }
</style>