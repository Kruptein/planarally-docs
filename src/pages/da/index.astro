---
import Main from "../../layouts/main.astro";

const paths = [
    {
        href: "/da/learn/",
        title: "Lær",
        description: "Trinvise vejledninger til spillere og DM. Hvis du er ny, så start her.",
    },
    {
        href: "/da/docs/",
        title: "Dokumentation",
        description: "Reference for funktioner, værktøjer og mere.",
    },
    {
        href: "/da/server/setup/",
        title: "Server",
        description: "Host PlanarAlly selv, konfigurer din installation og administrer brugere.",
    },
    {
        href: "/da/blog/",
        title: "Blog",
        description: "Release notes og udviklingsnyheder.",
    },
];

const features = [
    {
        title: "Belysning og syn",
        description: "Dynamisk belysning og synslinjer.",
        href: "/da/docs/dm/lighting-vision/",
    },
    {
        title: "Lag, etager og lokationer",
        description: "Organiser kort på tværs af lag, etager og scener.",
        href: "/da/docs/game/gameboard/",
    },
    {
        title: "Aktiver og skabeloner",
        description: "Upload kort og tokens, gem præsæt til genbrug.",
        href: "/da/docs/dm/assets/",
    },
    {
        title: "Build- og Play-værktøjer",
        description: "Forbered i Build-tilstand, og afhold sessionen i Play-tilstand.",
        href: "/da/docs/tools-overview/",
    },
    {
        title: "Selvhost",
        description: "Kør offline og behold fuld kontrol over dine data.",
        href: "/da/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="PlanarAlly logo"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                Et open source virtuelt spillebord til bordrollespil. Host selv, spil offline og afhold medrivende
                sessioner med belysning, syn og et fleksibelt kortsystem.
            </p>
        </section>

        <section class="paths">
            <h2>Hurtig start</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>Nøglefunktioner</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>
