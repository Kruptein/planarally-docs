---
import Main from "../../layouts/main.astro";

const paths = [
    {
        href: "/ja/learn/",
        title: "学ぶ",
        description: "プレイヤーと DM 向けのステップバイステップのチュートリアル。初心者はここから始めましょう。",
    },
    {
        href: "/ja/docs/",
        title: "ドキュメント",
        description: "機能やツールなどのリファレンスドキュメント。",
    },
    {
        href: "/ja/server/setup/",
        title: "サーバー",
        description: "PlanarAlly をセルフホストし、インスタンスを設定してユーザーを管理しましょう。",
    },
    {
        href: "/ja/blog/",
        title: "ブログ",
        description: "リリースノートと開発アップデート。",
    },
];

const features = [
    {
        title: "照明と視野",
        description: "動的な光と視線。",
        href: "/ja/docs/dm/lighting-vision/",
    },
    {
        title: "レイヤー、フロアとロケーション",
        description: "レイヤー、フロア、シーンをまたいでマップを整理します。",
        href: "/ja/docs/game/gameboard/",
    },
    {
        title: "アセットとテンプレート",
        description: "マップやトークンをアップロードし、再利用可能なプリセットを保存します。",
        href: "/ja/docs/dm/assets/",
    },
    {
        title: "Build と Play ツール",
        description: "Build モードで準備し、Play モードでセッションを進行します。",
        href: "/ja/docs/tools-overview/",
    },
    {
        title: "セルフホスト",
        description: "オフラインで実行し、データを完全に管理できます。",
        href: "/ja/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="PlanarAlly ロゴ"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                テーブルトークRPG向けのオープンソースのバーチャルテーブルトップ。セルフホストしてオフラインで遊び、
                照明、視野、柔軟なマップシステムで没入感のあるゲームを進行できます。
            </p>
        </section>

        <section class="paths">
            <h2>始めましょう</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>主な機能</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>