---
import Main from "../../layouts/main.astro";

const paths = [
    {
        href: "/it/learn/",
        title: "Impara",
        description: "Tutorial passo passo per giocatori e DM. Inizia qui se sei nuovo.",
    },
    {
        href: "/it/docs/",
        title: "Documentazione",
        description: "Documentazione di riferimento per funzionalità, strumenti e altro.",
    },
    {
        href: "/it/server/setup/",
        title: "Server",
        description: "Self-hosta PlanarAlly, configura la tua istanza e gestisci gli utenti.",
    },
    {
        href: "/it/blog/",
        title: "Blog",
        description: "Note di rilascio e aggiornamenti sullo sviluppo.",
    },
];

const features = [
    {
        title: "Illuminazione e visione",
        description: "Luci dinamiche e linea di vista.",
        href: "/it/docs/dm/lighting-vision/",
    },
    {
        title: "Livelli, piani e luoghi",
        description: "Organizza le mappe tra livelli, piani e scene.",
        href: "/it/docs/game/gameboard/",
    },
    {
        title: "Asset e modelli",
        description: "Carica mappe e segnalini, salva preset riutilizzabili.",
        href: "/it/docs/dm/assets/",
    },
    {
        title: "Strumenti Build e Play",
        description: "Prepara in modalità Build, gioca in modalità Play.",
        href: "/it/docs/tools-overview/",
    },
    {
        title: "Self-hosting",
        description: "Gioca offline con pieno controllo dei tuoi dati.",
        href: "/it/server/setup/",
    },
];
---

<Main>
    <main>
        <section class="hero">
            <img
                id="logo"
                src="/logos/pa-logo.svg"
                alt="Logo di PlanarAlly"
                data-no-zoom
            />
            <h1>PlanarAlly</h1>
            <p class="tagline">
                Un tavolo virtuale open-source per giochi di ruolo da tavolo.
                Self-hostalo, gioca offline e gestisci partite immersive con
                illuminazione, visione e un sistema di mappe flessibile.
            </p>
        </section>

        <section class="paths">
            <h2>Inizia qui</h2>
            <div class="cards">
                {
                    paths.map((path) => (
                        <a class="card" href={path.href}>
                            <div class="card-title">{path.title}</div>
                            <p>{path.description}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="features">
            <h2>Funzionalità principali</h2>
            <ul>
                {
                    features.map((feature) => (
                        <li>
                            <a href={feature.href}>{feature.title}</a>
                            <span> — {feature.description}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Main>

<style lang="scss">
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 50px 25px 100px;
    }

    section {
        width: 100%;
        max-width: 900px;
        margin-bottom: 4rem;

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 1.5rem;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;

        h1 {
            margin-bottom: 1rem;
        }

        .tagline {
            max-width: 600px;
            line-height: 1.6;
        }
    }

    #logo {
        height: 160px;
        width: 160px;
        margin-bottom: 2rem;
        padding: 25px;
        background: #f1e7d0e1;
        border-radius: 25%;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: block;
        border: solid 1px rgb(226, 236, 236);
        padding: 1.5rem;
        color: inherit;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        &:hover {
            transform: translateY(-3px);
            box-shadow: 2px 2px 15px 0 #cfe6e6;
        }

        .card-title {
            font-size: x-large;
            font-weight: bold;
            margin-bottom: 0.75rem;
            color: #00835c;
        }

        p {
            margin: 0;
            line-height: 1.5;
        }
    }

    .features {
        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 0.75rem 0;
            border-bottom: solid 1px rgb(226, 236, 236);
            line-height: 1.5;

            &:last-child {
                border-bottom: none;
            }
        }

        a {
            color: #00835c;
            font-weight: bold;
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }

        span {
            color: var(---fg-color);
        }
    }
</style>
