---
// src/layouts/main.astro
import "../styles/global.scss";
import Header from "./header.astro";
import { languages, defaultLang } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const availableLocales = Object.keys(languages).filter(l => l !== defaultLang);
---

<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="dark light" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <title>PlanarAlly Documentation</title>
        
        <script is:inline define:vars={{ availableLocales, defaultLang }}>
            (function() {
                let preferredLang = localStorage.getItem('preferredLang');
                const path = window.location.pathname;
                
                const supportedLangs = [defaultLang, ...availableLocales];

                if (preferredLang && !supportedLangs.includes(preferredLang)) {
                    localStorage.removeItem('preferredLang');
                    preferredLang = null;
                }
                
                let currentUrlLang = defaultLang;
                for (const l of availableLocales) {
                    if (path.startsWith('/' + l + '/') || path === '/' + l) {
                        currentUrlLang = l;
                        break;
                    }
                }

                if (!preferredLang) {
                    localStorage.setItem('preferredLang', currentUrlLang);
                    return;
                }

                if (preferredLang !== currentUrlLang) {
                    let newPath = path;

                    if (currentUrlLang !== defaultLang) {
                        newPath = path.replace(new RegExp('^/' + currentUrlLang + '(/|$)'), '/');
                    }

                    if (preferredLang !== defaultLang) {
                        newPath = '/' + preferredLang + (newPath.startsWith('/') ? newPath : '/' + newPath);
                        newPath = newPath.replace('//', '/');
                    }

                    window.location.replace(newPath);
                }
            })();
        </script>
        <script defer data-domain="planarally.io" src="https://plausible.io/js/script.js"></script>

        <script>
            import mediumZoom from "medium-zoom";
            mediumZoom("img:not([data-no-zoom])", { background: "transparent" });
        </script>
    </head>

    <body>
        <script is:inline>
            const currentTheme = localStorage.getItem("theme");
            if (currentTheme === "dark") {
                document.body.classList.toggle("dark-theme");
            } else if (currentTheme === "light") {
                document.body.classList.toggle("light-theme");
            }
        </script>
        <Header />
        <slot />
    </body>
</html>