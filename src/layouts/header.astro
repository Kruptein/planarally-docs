---
// src/layouts/header.astro
import Discord from "~icons/fa-brands/discord";
import Github from "~icons/fa-brands/github";
import MenuIcon from "~icons/lucide/menu";
import CloseIcon from "~icons/lucide/x";
import NavItem from "../components/NavItem.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.vue";
import LanguagePicker from "../components/LanguagePicker.astro";

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="site-header">
    <div class="header-container">
        <div class="header-left">
            <a href={getRelativeLocaleUrl(lang, '/')} class="brand">
                <img id="logo" src="/logos/pa-logo-small.svg" alt="PlanarAlly Logo" data-no-zoom />
                <span id="logo-text">PlanarAlly</span>
            </a>

            <nav class="desktop-nav">
                <NavItem to={getRelativeLocaleUrl(lang, '/docs/')}>{t('nav.docs')}</NavItem>
                <NavItem to={getRelativeLocaleUrl(lang, '/learn/')}>{t('nav.learn')}</NavItem>
                <NavItem to={getRelativeLocaleUrl(lang, '/server/')}>{t('nav.server')}</NavItem>
                <NavItem to={getRelativeLocaleUrl(lang, '/blog/')}>{t('nav.blog')}</NavItem>
            </nav>
        </div>

        <div class="header-right">
            <LanguagePicker />
            
            <div class="action-btn" title="Toggle theme">
                <ThemeSwitcher client:only="vue" />
            </div>

            <div class="social-links">
                <a
                    class="social-link"
                    aria-label="discord"
                    href="//discord.gg/mubGnTe"
                    rel="noopener noreferrer"
                    target="_blank"
                    title="Join us on Discord"
                >
                    <Discord />
                </a>

                <a
                    class="social-link"
                    aria-label="github"
                    href="//github.com/Kruptein/planarally"
                    rel="noopener noreferrer"
                    target="_blank"
                    title="PlanarAlly @ GitHub"
                >
                    <Github />
                </a>
            </div>

            <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
                <MenuIcon class="icon-menu" />
                <CloseIcon class="icon-close" />
            </button>
        </div>
    </div>

    <div id="mobile-nav-menu" class="mobile-nav-menu">
        <nav class="mobile-nav-links">
            <NavItem to={getRelativeLocaleUrl(lang, '/docs/')}>{t('nav.docs')}</NavItem>
            <NavItem to={getRelativeLocaleUrl(lang, '/learn/')}>{t('nav.learn')}</NavItem>
            <NavItem to={getRelativeLocaleUrl(lang, '/server/')}>{t('nav.server')}</NavItem>
            <NavItem to={getRelativeLocaleUrl(lang, '/blog/')}>{t('nav.blog')}</NavItem>
        </nav>
    </div>
</header>

<script>
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');

    if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = mobileMenu.classList.toggle('is-open');
            toggleBtn.classList.toggle('is-active', isOpen);
            toggleBtn.setAttribute('aria-expanded', String(isOpen));
        });

        document.addEventListener('click', (e) => {
            if (mobileMenu.classList.contains('is-open') && !mobileMenu.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
                mobileMenu.classList.remove('is-open');
                toggleBtn.classList.remove('is-active');
                toggleBtn.setAttribute('aria-expanded', 'false');
            }
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 820 && mobileMenu.classList.contains('is-open')) {
                mobileMenu.classList.remove('is-open');
                toggleBtn.classList.remove('is-active');
                toggleBtn.setAttribute('aria-expanded', 'false');
            }
        });
    }
</script>

<style lang="scss">
    @use "../styles/layout.scss" as *;

    .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        height: $header-height;
        border-bottom: solid 1px rgba(226, 236, 236, 0.7);
        background-color: var(---bg-header);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        width: 100%;
    }

    .header-container {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;

        @media (max-width: 480px) {
            padding: 0 0.75rem;
            gap: 0.4rem;
        }
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        min-width: 0;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: var(---fg-color);
        flex-shrink: 0;

        #logo {
            height: 36px;
            width: 36px;
            padding: 4px;
            background: #f1e7d0e1;
            border-radius: 8px;
            object-fit: contain;
        }

        #logo-text {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;

            @media (max-width: 360px) {
                display: none;
            }
        }
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;

        @media (max-width: 820px) {
            display: none;
        }
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;

        @media (max-width: 480px) {
            gap: 0.3rem;
        }
    }

    .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;

        :global(a) {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 6px;
            color: var(---fg-color);
            transition: color 0.15s ease, background-color 0.15s ease;

            &:hover {
                color: #00835c;
                background-color: rgba(128, 128, 128, 0.12);
            }
        }
    }

    .social-links {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        border-left: 1px solid rgba(150, 150, 150, 0.25);
        padding-left: 0.4rem;
        flex-shrink: 0;
    }

    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        color: var(---fg-color);
        font-size: 0.95rem;
        transition: color 0.15s ease, background-color 0.15s ease;

        &:hover {
            color: #00835c;
            background-color: rgba(128, 128, 128, 0.12);
        }
    }

    .mobile-nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid rgba(150, 150, 150, 0.25);
        border-radius: 6px;
        color: var(---fg-color);
        width: 30px;
        height: 30px;
        cursor: pointer;
        padding: 0;
        transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;

        &:hover {
            color: #00835c;
            border-color: #00835c;
            background-color: rgba(0, 131, 92, 0.05);
        }

        .icon-close {
            display: none;
            width: 18px;
            height: 18px;
        }

        .icon-menu {
            display: block;
            width: 18px;
            height: 18px;
        }

        &.is-active {
            color: #00835c;
            border-color: #00835c;

            .icon-menu {
                display: none;
            }

            .icon-close {
                display: block;
            }
        }

        @media (max-width: 820px) {
            display: flex;
        }
    }

    .mobile-nav-menu {
        display: none;

        @media (max-width: 820px) {
            display: block;
            position: absolute;
            top: $header-height;
            left: 0;
            right: 0;
            background-color: var(---bg-header);
            border-bottom: 1px solid rgba(226, 236, 236, 0.8);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
            padding: 0.8rem 1.25rem;
            transform: translateY(-8px);
            opacity: 0;
            pointer-events: none;
            transition: transform 0.2s ease, opacity 0.2s ease;
            backdrop-filter: blur(10px);

            &.is-open {
                transform: translateY(0);
                opacity: 1;
                pointer-events: auto;
            }
        }
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        :global(.nav-item) {
            font-size: 1rem;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            width: 100%;

            &:hover {
                background-color: rgba(0, 131, 92, 0.08);
            }
        }

        :global(.current-link) {
            background-color: rgba(0, 131, 92, 0.1);

            &::after {
                display: none;
            }
        }
    }
</style>
