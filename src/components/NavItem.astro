---
const { to } = Astro.props;
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '');
const targetPath = to.replace(/\/$/, '');
const isActive = currentPath === targetPath || currentPath.startsWith(targetPath + '/');
const classes = `nav-item ${isActive ? "current-link" : ""}`;
---

<a href={to} class={classes}>
    <slot />
</a>

<style lang="scss">
    .nav-item {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.6rem;
        border-radius: 4px;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(---fg-color);
        text-decoration: none;
        position: relative;
        white-space: nowrap;
        transition: color 0.15s ease, background-color 0.15s ease;

        &:hover {
            color: #00835c;
            background-color: rgba(0, 131, 92, 0.05);
        }
    }

    .current-link {
        color: #00835c !important;
        font-weight: 600;

        &::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0.6rem;
            right: 0.6rem;
            height: 2px;
            border-radius: 1px;
            background-color: #00835c;
        }
    }
</style>
